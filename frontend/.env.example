# Copiar a frontend/.env y reiniciar `npm run dev`. Vite solo lee variables con prefijo VITE_
# desde frontend/.env; el .env de la raíz es del backend y NO llega al navegador.
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional: mapa para validar el lugar de un incidente. Google Cloud -> habilitar "Maps Embed API"
# y crear una clave restringida por HTTP referrer (http://localhost:5173/*, el dominio del panel)
# y por API (solo Maps Embed API). Es visible en el navegador: no uses la clave de Gemini ni la del servidor.
# Sin clave el panel muestra coordenadas y un enlace a Google Maps.
VITE_GOOGLE_MAPS_API_KEY=
