{
  "$defs": {
    "OrigenDato": {
      "enum": [
        "real",
        "estimado",
        "sintetico"
      ],
      "title": "OrigenDato",
      "type": "string"
    },
    "Ubicacion": {
      "additionalProperties": false,
      "properties": {
        "latitud": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitud",
          "type": "number"
        },
        "longitud": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitud",
          "type": "number"
        },
        "fuente": {
          "enum": [
            "catalogo",
            "compartida",
            "coordinador",
            "escenario"
          ],
          "title": "Fuente",
          "type": "string"
        },
        "precision_metros": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precision Metros"
        },
        "representa_punto_atencion": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Representa Punto Atencion"
        }
      },
      "required": [
        "latitud",
        "longitud",
        "fuente"
      ],
      "title": "Ubicacion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "esquema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Esquema Version",
      "type": "string"
    },
    "ejecucion_id": {
      "format": "uuid",
      "title": "Ejecucion Id",
      "type": "string"
    },
    "creado_en": {
      "format": "date-time",
      "title": "Creado En",
      "type": "string"
    },
    "origen": {
      "$ref": "#/$defs/OrigenDato"
    },
    "aclaracion_id": {
      "format": "uuid",
      "title": "Aclaracion Id",
      "type": "string"
    },
    "reporte_id": {
      "format": "uuid",
      "title": "Reporte Id",
      "type": "string"
    },
    "texto": {
      "anyOf": [
        {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Texto"
    },
    "ubicacion_compartida": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ubicacion"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "ejecucion_id",
    "creado_en",
    "origen",
    "aclaracion_id",
    "reporte_id"
  ],
  "title": "RespuestaAclaracion",
  "type": "object"
}
