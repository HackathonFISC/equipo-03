{
  "$defs": {
    "EstadoValidacion": {
      "enum": [
        "pendiente",
        "validada",
        "rechazada"
      ],
      "title": "EstadoValidacion",
      "type": "string"
    },
    "OrigenDato": {
      "enum": [
        "real",
        "estimado",
        "sintetico"
      ],
      "title": "OrigenDato",
      "type": "string"
    },
    "Ubicacion": {
      "additionalProperties": false,
      "properties": {
        "latitud": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitud",
          "type": "number"
        },
        "longitud": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitud",
          "type": "number"
        },
        "fuente": {
          "enum": [
            "catalogo",
            "compartida",
            "coordinador",
            "escenario",
            "geocodificada"
          ],
          "title": "Fuente",
          "type": "string"
        },
        "precision_metros": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precision Metros"
        },
        "representa_punto_atencion": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Representa Punto Atencion"
        }
      },
      "required": [
        "latitud",
        "longitud",
        "fuente"
      ],
      "title": "Ubicacion",
      "type": "object"
    },
    "VentanaTiempo": {
      "additionalProperties": false,
      "properties": {
        "inicio": {
          "format": "date-time",
          "title": "Inicio",
          "type": "string"
        },
        "fin": {
          "format": "date-time",
          "title": "Fin",
          "type": "string"
        }
      },
      "required": [
        "inicio",
        "fin"
      ],
      "title": "VentanaTiempo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "esquema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Esquema Version",
      "type": "string"
    },
    "ejecucion_id": {
      "format": "uuid",
      "title": "Ejecucion Id",
      "type": "string"
    },
    "creado_en": {
      "format": "date-time",
      "title": "Creado En",
      "type": "string"
    },
    "origen": {
      "$ref": "#/$defs/OrigenDato"
    },
    "incidente_id": {
      "format": "uuid",
      "title": "Incidente Id",
      "type": "string"
    },
    "version": {
      "exclusiveMinimum": 0,
      "title": "Version",
      "type": "integer"
    },
    "sector_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sector Id"
    },
    "punto_atencion_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Punto Atencion Id"
    },
    "reportes_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "minItems": 1,
      "title": "Reportes Ids",
      "type": "array"
    },
    "reportes_independientes": {
      "minimum": 0,
      "title": "Reportes Independientes",
      "type": "integer"
    },
    "ubicacion": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ubicacion"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "estado_validacion": {
      "$ref": "#/$defs/EstadoValidacion"
    },
    "confianza": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confianza"
    },
    "conflictos": {
      "items": {
        "maxLength": 4000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Conflictos",
      "type": "array"
    },
    "faltantes": {
      "items": {
        "maxLength": 4000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Faltantes",
      "type": "array"
    },
    "requiere_revision_urgente": {
      "default": false,
      "title": "Requiere Revision Urgente",
      "type": "boolean"
    },
    "periodo_incidente": {
      "$ref": "#/$defs/VentanaTiempo"
    },
    "primera_deteccion_en": {
      "format": "date-time",
      "title": "Primera Deteccion En",
      "type": "string"
    }
  },
  "required": [
    "ejecucion_id",
    "creado_en",
    "origen",
    "incidente_id",
    "version",
    "reportes_ids",
    "reportes_independientes",
    "estado_validacion",
    "periodo_incidente",
    "primera_deteccion_en"
  ],
  "title": "IncidenteConsolidado",
  "type": "object"
}
