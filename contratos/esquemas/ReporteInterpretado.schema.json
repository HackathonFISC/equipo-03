{
  "$defs": {
    "CamposReporte": {
      "additionalProperties": false,
      "properties": {
        "horas_sin_agua": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Horas Sin Agua"
        },
        "personas_afectadas": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Personas Afectadas"
        },
        "vulnerabilidad_declarada": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vulnerabilidad Declarada"
        },
        "institucion_declarada": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Institucion Declarada"
        },
        "tipo_problema": {
          "enum": [
            "sin_suministro",
            "intermitencia",
            "otro",
            "desconocido"
          ],
          "title": "Tipo Problema",
          "type": "string"
        }
      },
      "required": [
        "tipo_problema"
      ],
      "title": "CamposReporte",
      "type": "object"
    },
    "Evidencia": {
      "additionalProperties": false,
      "properties": {
        "evidencia_id": {
          "format": "uuid",
          "title": "Evidencia Id",
          "type": "string"
        },
        "reporte_id": {
          "format": "uuid",
          "title": "Reporte Id",
          "type": "string"
        },
        "tipo": {
          "enum": [
            "texto",
            "ubicacion",
            "audio",
            "foto",
            "coordinador"
          ],
          "title": "Tipo",
          "type": "string"
        },
        "referencia": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Referencia",
          "type": "string"
        },
        "descripcion": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Descripcion",
          "type": "string"
        },
        "campos_respaldados": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Campos Respaldados",
          "type": "array"
        }
      },
      "required": [
        "evidencia_id",
        "reporte_id",
        "tipo",
        "referencia",
        "descripcion",
        "campos_respaldados"
      ],
      "title": "Evidencia",
      "type": "object"
    },
    "ExtraccionReporteLLM": {
      "additionalProperties": false,
      "description": "Única forma de extracción para el LLM; no acepta IDs, coordenadas o permisos.",
      "properties": {
        "resumen": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Resumen",
          "type": "string"
        },
        "ubicacion_declarada": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ubicacion Declarada"
        },
        "campos": {
          "$ref": "#/$defs/CamposReporte"
        },
        "evidencia_textual": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidencia Textual",
          "type": "array"
        },
        "faltantes": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Faltantes",
          "type": "array"
        },
        "requiere_aclaracion": {
          "title": "Requiere Aclaracion",
          "type": "boolean"
        },
        "fuera_de_alcance": {
          "title": "Fuera De Alcance",
          "type": "boolean"
        }
      },
      "required": [
        "resumen",
        "ubicacion_declarada",
        "campos",
        "evidencia_textual",
        "faltantes",
        "requiere_aclaracion",
        "fuera_de_alcance"
      ],
      "title": "ExtraccionReporteLLM",
      "type": "object"
    },
    "OrigenDato": {
      "enum": [
        "real",
        "estimado",
        "sintetico"
      ],
      "title": "OrigenDato",
      "type": "string"
    },
    "Ubicacion": {
      "additionalProperties": false,
      "properties": {
        "latitud": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitud",
          "type": "number"
        },
        "longitud": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitud",
          "type": "number"
        },
        "fuente": {
          "enum": [
            "catalogo",
            "compartida",
            "coordinador",
            "escenario"
          ],
          "title": "Fuente",
          "type": "string"
        },
        "precision_metros": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precision Metros"
        },
        "representa_punto_atencion": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Representa Punto Atencion"
        }
      },
      "required": [
        "latitud",
        "longitud",
        "fuente"
      ],
      "title": "Ubicacion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "esquema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Esquema Version",
      "type": "string"
    },
    "ejecucion_id": {
      "format": "uuid",
      "title": "Ejecucion Id",
      "type": "string"
    },
    "creado_en": {
      "format": "date-time",
      "title": "Creado En",
      "type": "string"
    },
    "origen": {
      "$ref": "#/$defs/OrigenDato"
    },
    "reporte_id": {
      "format": "uuid",
      "title": "Reporte Id",
      "type": "string"
    },
    "modalidad": {
      "enum": [
        "texto",
        "voz",
        "foto",
        "ubicacion"
      ],
      "title": "Modalidad",
      "type": "string"
    },
    "interpretacion": {
      "$ref": "#/$defs/ExtraccionReporteLLM"
    },
    "evidencias": {
      "items": {
        "$ref": "#/$defs/Evidencia"
      },
      "minItems": 1,
      "title": "Evidencias",
      "type": "array"
    },
    "ubicacion_compartida": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ubicacion"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "ejecucion_id",
    "creado_en",
    "origen",
    "reporte_id",
    "modalidad",
    "interpretacion",
    "evidencias"
  ],
  "title": "ReporteInterpretado",
  "type": "object"
}
