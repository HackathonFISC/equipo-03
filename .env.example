# Copiar a .env y llenar. Nunca subir .env.
# Verificar los nombres exactos que pida cada librería (José mantiene este archivo).

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # solo backend

# Modelo (Gemini vía Google AI Studio)
GEMINI_API_KEY=
# Opcional: confirmar disponibilidad del modelo con Emilia; vacío usa el valor del adaptador.
GEMINI_MODEL=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS_PRUEBA=       # chats autorizados para la demo, separados por coma
API_SECRETO_BOT=
# Dirección de la API usada por el bot; no es una clave.
API_URL=http://127.0.0.1:8000

# General
TZ=America/Panama
# La API inicia el trabajador de agentes automáticamente. false solo para un trabajador externo.
TRABAJADOR_AUTOMATICO=true
