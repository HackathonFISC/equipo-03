# Copiar a .env y llenar. Nunca subir .env.
# Verificar los nombres exactos que pida cada librería (José mantiene este archivo).

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # solo backend

# Modelo (Gemini vía Google AI Studio)
GEMINI_API_KEY=
# Opcional: confirmar disponibilidad del modelo con Emilia; vacío usa el valor del adaptador.
GEMINI_MODEL=

# Telegram
TELEGRAM_BOT_TOKEN=
# true: el bot atiende a cualquier persona o grupo. Vacío: solo los chats de la lista siguiente.
TELEGRAM_ACCESO_PUBLICO=
TELEGRAM_CHAT_IDS_PRUEBA=       # modo de prueba: chats autorizados, separados por coma
API_SECRETO_BOT=
# Opcional, modo público: mensajes por persona / en total en cada ventana de minutos (8 / 120 / 10).
BOT_LIMITE_USUARIO=
BOT_LIMITE_TOTAL=
BOT_VENTANA_MINUTOS=
# Dirección de la API usada por el bot; no es una clave.
API_URL=http://127.0.0.1:8000

# General
TZ=America/Panama
# La API inicia el trabajador de agentes automáticamente. false solo para un trabajador externo.
TRABAJADOR_AUTOMATICO=true

# Google Maps Geocoding API v4. Solo backend; nunca usar VITE_ ni enviarla al navegador.
GOOGLE_MAPS_API_KEY=

# Routes API: true usa tiempos viales en nuevas ejecuciones de planificación.
GOOGLE_ROUTES_ACTIVAS=false
# Opcional: clave independiente. Vacío reutiliza GOOGLE_MAPS_API_KEY.
GOOGLE_ROUTES_API_KEY=

# Opcional: modelo con entrada de audio. Vacío reutiliza GEMINI_MODEL.
GEMINI_AUDIO_MODEL=

# Mapa del panel (validar el lugar): VITE_GOOGLE_MAPS_API_KEY va en frontend/.env, con una clave distinta
# (Maps Embed API, restringida por referrer). Ver frontend/.env.example y docs/VALIDACION_LUGAR.md.
